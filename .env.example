# ==============================================================================
# THE CREATORS — Environment Variables Template
# Keep all real credentials in .env (never commit secrets)
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/creators_db"

# Security & Session Secrets (Cryptographically random string, at least 32 characters in production)
SESSION_SECRET="replace_with_a_secure_random_32_character_secret_key"
JWT_SECRET="replace_with_a_secure_random_32_character_secret_key"

# Frontend & CORS Origins
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:5000"

# Client-Side API Base URL (For separate Vercel frontend pointing to Render backend)
# In dev or same-origin deployments, leave empty to use relative /api paths
VITE_API_BASE_URL=""
VITE_BACKEND_URL="http://localhost:5000"

# ==============================================================================
# Google OAuth 2.0 & Identity Services (GIS)
# ==============================================================================
# 1. Create a Google Cloud Project at https://console.cloud.google.com/
# 2. Configure OAuth consent screen:
#    - User type: External
#    - Scopes: openid, email, profile
# 3. Create Credentials -> OAuth 2.0 Client IDs -> Application type: "Web application"
#    - Authorized JavaScript origins:
#        http://localhost:3000
#        http://localhost:5000
#        https://your-production-app.com
#    - Authorized redirect URIs:
#        http://localhost:5000/api/auth/google/callback
#        https://your-production-backend.com/api/auth/google/callback
# 4. Copy the Client ID below:
GOOGLE_CLIENT_ID=""
VITE_GOOGLE_CLIENT_ID=""

# Optional Email Service (SMTP)
ADMIN_EMAIL="thecreators.pvt.ltd@gmail.com"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""

# Optional Discord Webhook (No PII is logged)
DISCORD_WEBHOOK_URL=""
